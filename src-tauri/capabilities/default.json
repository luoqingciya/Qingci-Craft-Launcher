{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口的默认能力。应用自定义命令不需要在这里声明权限。",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "opener:default"
  ]
}
